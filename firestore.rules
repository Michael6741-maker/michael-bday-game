rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leaderboard: read-only for clients
    // Writes are only allowed via Cloud Functions (Admin SDK bypasses rules)
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if false;
    }
    
    // Game sessions: no direct client access
    match /gameSessions/{session} {
      allow read, write: if false;
    }

    match /seasonConfigs/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    match /proPassConfigs/{passId} {
      allow read: if true;
      allow write: if false;
    }
    
    // User-created levels — public reads only; writes via Cloud Functions (MIE-19).
    match /levels/{levelId} {
      allow read: if resource.data.visibility == 'public'
        && (resource.data.archived == false || !('archived' in resource.data));
      allow write: if false;
    }
    
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function noPasswordField() {
      return !('password' in request.resource.data);
    }

    function economyUnchanged() {
      return request.resource.data.get('totalCoins', 0) == resource.data.get('totalCoins', 0)
        && request.resource.data.get('totalGems', 0) == resource.data.get('totalGems', 0)
        && request.resource.data.get('totalMeters', 0) == resource.data.get('totalMeters', 0)
        && request.resource.data.get('ownedBalls', []) == resource.data.get('ownedBalls', [])
        && request.resource.data.get('gamepasses', {}) == resource.data.get('gamepasses', {})
        && request.resource.data.get('seasonData', null) == resource.data.get('seasonData', null)
        && request.resource.data.get('proPassData', null) == resource.data.get('proPassData', null)
        && request.resource.data.get('extraBalls', 0) == resource.data.get('extraBalls', 0)
        && request.resource.data.get('auroraShards', 0) == resource.data.get('auroraShards', 0)
        && request.resource.data.get('auroraBallUnlocked', false) == resource.data.get('auroraBallUnlocked', false)
        && request.resource.data.get('fossilInventory', {}) == resource.data.get('fossilInventory', {})
        && request.resource.data.get('fossilCraftJob', null) == resource.data.get('fossilCraftJob', null)
        && request.resource.data.get('ownedAvatarItems', []) == resource.data.get('ownedAvatarItems', [])
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
    }

    function ownerCosmeticOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'avatarId', 'selectedBall', 'skinColor', 'equippedAvatar', 'playerSettings',
        'lastSeenAtMs', 'unreadChats', 'seenMessageIds', 'pendingGifts'
      ]);
    }

    function selectedBallOwned() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['selectedBall'])
        || request.resource.data.selectedBall == 'default'
        || resource.data.get('ownedBalls', []).hasAny([request.resource.data.selectedBall]);
    }

    // Coins, gems, balls, passes, and season progress change only through Cloud Functions.
    // A signed-in player may edit cosmetics on their own profile.
    match /users/{username} {
      allow read: if signedIn();
      allow create: if isOwner(username)
        && noPasswordField()
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('totalCoins', 0) == 0
        && request.resource.data.get('totalGems', 0) == 0;
      allow update: if (isAdmin() && noPasswordField())
        || (isOwner(username) && noPasswordField() && economyUnchanged() && ownerCosmeticOnly() && selectedBallOwned());
      allow delete: if false;

      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // Public game content stays readable. Only an admin can publish or edit it.
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shopOffers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /answers/{username} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /avatarItems/{itemId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAtMs'])
          && request.resource.data.stock == resource.data.stock - 1);
    }

    // Avatar Item Studio drafts — owner read/write enforced via Cloud Functions (MIE-37).
    match /avatarStudioProjects/{projectId} {
      allow read: if false;
      allow write: if false;
    }

    function isGiftParty() {
      return signedIn() && (
        resource.data.fromUsername == request.auth.uid
        || resource.data.toUsername == request.auth.uid
      );
    }

    // Gift rows are visible to the people in the gift, and only the sender can write one.
    match /giftTransactions/{giftId} {
      allow read: if isGiftParty();
      allow create: if signedIn() && request.resource.data.fromUsername == request.auth.uid;
      allow update, delete: if false;
    }

    // Friends, races, and chats require the signed-in player to be a participant.
    match /friendRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.fromUsername == request.auth.uid
        || resource.data.toUsername == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.fromUsername == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.fromUsername == request.auth.uid
        || resource.data.toUsername == request.auth.uid
      );
      allow delete: if false;
    }

    match /friendships/{pairId} {
      allow read: if signedIn() && resource.data.usernames.hasAny([request.auth.uid]);
      allow create: if signedIn() && request.resource.data.usernames.hasAny([request.auth.uid]);
      allow update, delete: if signedIn() && resource.data.usernames.hasAny([request.auth.uid]);
    }

    match /raceChallenges/{challengeId} {
      allow read: if signedIn() && (
        resource.data.challenger == request.auth.uid
        || resource.data.opponent == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.challenger == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.challenger == request.auth.uid
        || resource.data.opponent == request.auth.uid
      );
      allow delete: if false;
    }

    match /chats/{pairId} {
      allow read, create: if signedIn() && pairId.split('__').hasAny([request.auth.uid]);
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && pairId.split('__').hasAny([request.auth.uid]);
        allow create: if signedIn()
          && pairId.split('__').hasAny([request.auth.uid])
          && request.resource.data.fromUsername == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
